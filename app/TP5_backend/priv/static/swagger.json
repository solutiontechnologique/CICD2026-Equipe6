  "swagger": "2.0",
  "schemes": [
    "http"
  ],
  "paths": {
    "/addboat": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Ajoute un nouveau bateau",
        "operationId": "MyappWeb.BoatController.add_boat",
        "parameters": [
          {
            "description": "Informations du bateau",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/BoatInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Bateau ajouté",
            "schema": {
              "$ref": "#/definitions/BoatCreateResponse"
            }
          },
          "400": {
            "description": "Paramètres manquants",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Erreur serveur",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Ajouter un bateau",
        "tags": [
          "Boat"
        ]
      }
    },
    "/addparticipanttorace": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Ajoute un bateau à une course non terminée",
        "operationId": "MyappWeb.RaceController.add_participant_to_race",
        "parameters": [
          {
            "description": "Participant à ajouter",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ParticipantInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Participant ajouté",
            "schema": {
              "$ref": "#/definitions/ParticipantAddResponse"
            }
          },
          "400": {
            "description": "Données invalides",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Course introuvable",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Participant déjà inscrit",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Erreur serveur",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Ajouter un participant à une course",
        "tags": [
          "Race"
        ]
      }
    },
    "/addparticipanttoserie": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Ajoute un bateau à une série et l'inscrit à toutes les courses de cette série",
        "operationId": "MyappWeb.SeriesController.add_participant_to_serie",
        "parameters": [
          {
            "description": "Participant à ajouter",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SerieParticipantInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Participant ajouté à la série"
          },
          "400": {
            "description": "Données invalides",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Série introuvable",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "409": {
            "description": "Participant déjà inscrit",
