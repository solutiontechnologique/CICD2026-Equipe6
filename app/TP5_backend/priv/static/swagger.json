            }
          },
          "500": {
            "description": "Erreur serveur",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Inscrire un participant à une série",
        "tags": [
          "Series"
        ]
      }
    },
    "/addrace": {
      "post": {
        "consumes": [
          "application/json"
        ],
        "description": "Crée une nouvelle course",
        "operationId": "MyappWeb.RaceController.add_race",
        "parameters": [
          {
            "description": "Informations de la course",
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/RaceInput"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Course ajoutée",
            "schema": {
              "$ref": "#/definitions/RaceCreateResponse"
            }
          },
          "400": {
            "description": "Paramètres manquants",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
            "description": "Erreur serveur",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ],
        "summary": "Ajouter une course",
        "tags": [
          "Race"
        ]
      }
    },
    "/deleteboat/{boat_id}": {
      "delete": {
        "description": "Supprime un bateau et le retire des courses où il est inscrit",
        "operationId": "MyappWeb.BoatController.delete_boat",
        "parameters": [
          {
            "description": "ID du bateau",
            "in": "path",
            "name": "boat_id",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Bateau supprimé"
          },
          "400": {
            "description": "ID invalide",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "404": {
            "description": "Bateau introuvable",
            "schema": {
              "$ref": "#/definitions/Error"
            }
          },
          "500": {
